rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified()
        && request.auth.token.email == 'yashrajmanawat0602@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isEmailVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'role',
          'themeMode',
          'notificationsEnabled',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'role',
          'themeMode',
          'preferredLanguage',
          'lastVisitedTab',
          'notificationsEnabled',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.role is string
        && data.role in ['ADMIN', 'TEACHER', 'PARENT', 'STUDENT', 'PORTAL_USER']
        && data.themeMode is string
        && data.themeMode in ['light', 'dark', 'school']
        && data.notificationsEnabled is bool
        && (!data.keys().hasAny(['preferredLanguage']) || (data.preferredLanguage is string && data.preferredLanguage.size() <= 32))
        && (!data.keys().hasAny(['lastVisitedTab']) || (data.lastVisitedTab is string && data.lastVisitedTab.size() <= 64))
        && (!data.keys().hasAny(['photoUrl']) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserNote(data) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'content',
          'category',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'content',
          'category',
          'completed',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 140
        && data.content is string
        && data.content.size() <= 2000
        && data.category is string
        && data.category in ['STUDY', 'HOMEWORK', 'REMINDER', 'SUPPORT']
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.createdAt is timestamp;
    }

    // Bootstrapped admins lookup collection
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isBootstrappedAdmin()
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Private User Profile & Portal Preferences (Strict PII Isolation)
    match /userProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isEmailVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isBootstrappedAdmin() || incoming().role == 'PORTAL_USER');

      allow update: if isEmailVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'email',
              'themeMode',
              'preferredLanguage',
              'lastVisitedTab',
              'notificationsEnabled',
              'photoUrl',
              'updatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    // Personal Saved Notes & Study Reminders (Strictly Scoped to Owner)
    match /userNotes/{noteId} {
      allow get: if isSignedIn()
        && isValidId(noteId)
        && (existing().ownerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isEmailVerified()
        && isValidId(noteId)
        && isValidUserNote(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isEmailVerified()
        && isValidId(noteId)
        && isValidUserNote(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().ownerId == request.auth.uid
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt'])
              || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'updatedAt'])
            )
          )
        );

      allow delete: if isEmailVerified()
        && isValidId(noteId)
        && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
