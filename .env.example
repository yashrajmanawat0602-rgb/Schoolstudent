# GEMINI_API_KEY: Optional for future AI features if configured in AI Studio Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL connection (automatically injected in AI Studio runtime)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Standard PostgreSQL connection string (used by Render / Supabase / Neon / Docker)
DATABASE_URL=

# HMAC secret for session & payment intent signing (auto-generated on Render Blueprint)
AUTH_SECRET=

# Optional Object Storage configuration for production deployments
STORAGE_URL=
STORAGE_BUCKET=
EMAIL_SERVER=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Optional Live Payment Gateway (Razorpay — supports PhonePe, Google Pay, Paytm, UPI, Cards)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

