{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user portal profile, theme preference, and last visited workspace state synced per authenticated Firebase user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "TEACHER", "PARENT", "STUDENT", "PORTAL_USER"]
        },
        "themeMode": {
          "type": "string",
          "enum": ["light", "dark", "school"]
        },
        "preferredLanguage": {
          "type": "string",
          "maxLength": 32
        },
        "lastVisitedTab": {
          "type": "string",
          "maxLength": 64
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "role",
        "themeMode",
        "notificationsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserNote": {
      "title": "UserNote",
      "description": "Personal study reminder, homework checklist item, or saved portal note owned by an authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "content": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": ["STUDY", "HOMEWORK", "REMINDER", "SUPPORT"]
        },
        "completed": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "content",
        "category",
        "completed",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Bootstrapped administrator marker keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and UI preferences document strictly scoped to owner UID or verified admin."
    },
    "/userNotes/{noteId}": {
      "schema": { "$ref": "#/entities/UserNote" },
      "description": "Personal study notes and task reminders strictly owned by request.auth.uid."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role verification markers readable by owner/admin."
    }
  }
}
